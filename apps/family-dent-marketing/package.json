{
  "name": "family-dent-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check lib/meta.mjs && node --check worker.mjs",
    "worker": "node --env-file-if-exists=.env worker.mjs"
  }
}

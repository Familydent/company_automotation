PORT=3000
APP_URL=http://localhost:3000
ALLOW_DEMO=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only the worker uses this privileged key. Never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
META_APP_ID=
META_APP_SECRET=
# Set to a supported Graph API version confirmed in your Meta dashboard.
META_GRAPH_VERSION=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Enable after live testing of formats/permissions on company accounts.
META_PUBLISHING_ENABLED=false
